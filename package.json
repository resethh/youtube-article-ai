{
  "name": "youtube-article-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "YouTube 字幕 → Gemini 流式生成中文对话文章，部署于 Cloudflare Worker",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
