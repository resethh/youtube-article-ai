# 复制为 .dev.vars 并填入真实值（仅本地 wrangler dev 使用，勿提交）
GEMINI_API_KEY=your_gemini_api_key_here

# 可选：YouTube 字幕降级代理（webshare.io 免费账号）
# PROXY_HOST=proxy.webshare.io
# PROXY_PORT=80
# PROXY_USER=
# PROXY_PASS=

# 可选：会话 TTL（秒），默认 86400
# SESSION_TTL_SECONDS=86400

# 可选：YouTube client profile（ANDROID / WEB / TV）
# YT_CLIENT=ANDROID
